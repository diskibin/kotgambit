# Copy to .env next to compose.prod.yml on the server and fill in. Never commit real values.
# The variables of the API that are not here (YooKassa, OAuth, reminders...) are described in the .env.example of the repository

# Domains. The site and the API each have their own, both point to the server
SITE_DOMAIN=example.com
API_DOMAIN=api.example.com

# Images that the deploy pulls, the tag is a commit or `latest`
WEB_IMAGE=ghcr.io/OWNER/kotgambit-web:latest
API_IMAGE=ghcr.io/OWNER/kotgambit-api:latest

# Long and random: `openssl rand -hex 32`
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=

# Emails need an SMTP server, the API refuses to start in production without it
SMTP_URL=
MAIL_FROM=Кот Гамбит <noreply@example.com>

# Who may open /admin: the emails of accounts that have signed in
ADMIN_EMAILS=

# The server has 2 cores: one engine process, the other core is left for everything else
ENGINE_WORKERS=1

# Where the checkout of the private content repository lies on the server
CONTENT_PRIVATE_HOST_DIR=/srv/kotgambit-content
