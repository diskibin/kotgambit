generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid(7)) @db.Uuid
  // Stored in lower case, the contract normalizes it before it gets here
  email       String   @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  credential    Credential?
  refreshTokens RefreshToken[]

  @@map("users")
}

model Credential {
  userId       String   @id @map("user_id") @db.Uuid
  // argon2id hash, the password itself is never stored
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // All tokens descended from one sign-in share a family, so that reuse can revoke the whole chain
  familyId   String    @map("family_id") @db.Uuid
  // SHA-256 of the token, the token itself is shown to the client once
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
