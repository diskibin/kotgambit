# Copy to backup.env next to backup.sh on the server and fill in. Never commit real values.
# Plain KEY=value lines, no spaces around the equals sign. chmod 600 backup.env

# The bucket in the S3 storage of the host (Beget: Cloud -> Object storage, the keys behind the eye icon)
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# These two are the ones of Beget, set them only for another host
# BACKUP_S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
# BACKUP_S3_REGION=ru1

# Long and random (`openssl rand -hex 32`). The copy in S3 is encrypted with it. Keep it ALSO outside of the server,
# in a password manager: without it the copies cannot be opened when the server is lost
BACKUP_PASSPHRASE=

# How long the copies live: on the server and in S3
# BACKUP_KEEP_DAYS=14
# BACKUP_REMOTE_KEEP_DAYS=30
