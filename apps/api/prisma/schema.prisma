generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  // Stored in lower case, the contract normalizes it before it gets here
  email            String    @unique
  displayName      String?   @map("display_name")
  // Set when the owner opens the link from the verification email, or resets the password through one
  emailVerifiedAt  DateTime? @map("email_verified_at")
  // Daily goal in minutes, the learner picks it in onboarding and settings
  dailyGoalMinutes Int       @default(10) @map("daily_goal_minutes")
  createdAt        DateTime  @default(now()) @map("created_at")

  credential     Credential?
  refreshTokens  RefreshToken[]
  emailTokens    EmailToken[]
  lessonProgress LessonProgress[]
  dailyActivity  DailyActivity[]
  puzzleAttempts PuzzleAttempt[]
  puzzleStats    UserPuzzleStats?

  @@map("users")
}

model Credential {
  userId       String   @id @map("user_id") @db.Uuid
  // argon2id hash, the password itself is never stored
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // All tokens descended from one sign-in share a family, so that reuse can revoke the whole chain
  familyId  String    @map("family_id") @db.Uuid
  // SHA-256 of the token, the token itself is shown to the client once
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum EmailTokenKind {
  verify_email
  reset_password

  @@map("email_token_kind")
}

// One-time links sent by email. Like refresh tokens, only the hash is stored.
model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("email_tokens")
}

// Lessons are loaded from the content files by the seed script, the table is a copy for fast reads
model Lesson {
  id          String   @id
  track       String
  order       Int
  access      String
  piece       String
  title       String
  summary     String
  minutes     Int
  // The steps as in the content file, validated by content-schema before they get here
  steps       Json
  contentHash String   @map("content_hash")
  updatedAt   DateTime @updatedAt @map("updated_at")

  progress LessonProgress[]

  @@unique([track, order])
  @@map("lessons")
}

model LessonProgress {
  userId       String   @map("user_id") @db.Uuid
  lessonId     String   @map("lesson_id")
  // Best result over all runs
  bestAccuracy Float    @map("best_accuracy")
  stars        Int
  attempts     Int      @default(1)
  completedAt  DateTime @map("completed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

// One row per learner and calendar day, the "день конём" and the streak are computed from it
model DailyActivity {
  userId  String   @map("user_id") @db.Uuid
  day     DateTime @db.Date
  seconds Int      @default(0)
  xp      Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("daily_activity")
}

// A subset of the Lichess puzzle database (CC0), loaded by the import script
model Puzzle {
  // The Lichess PuzzleId
  id              String   @id
  // The position before the opponent's move, as in the database
  fen             String
  // UCI moves: the opponent's move first, then the solver's move and the reply, ending with a solver move
  moves           String[]
  rating          Int
  ratingDeviation Int      @map("rating_deviation")
  popularity      Int
  plays           Int
  themes          String[]
  openingTags     String[] @map("opening_tags")

  attempts PuzzleAttempt[]
  daily    DailyPuzzle[]

  @@index([rating])
  // Finds the puzzles of a theme without scanning the table
  @@index([themes], type: Gin)
  @@map("puzzles")
}

enum PuzzleAttemptStatus {
  open
  solved
  failed
  abandoned

  @@map("puzzle_attempt_status")
}

// One run at a puzzle. The server keeps the moves played, so the client never sends a position or a history.
model PuzzleAttempt {
  id           String              @id @default(uuid(7)) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  puzzleId     String              @map("puzzle_id")
  // Solved is a clean run (hints up to level 2 allowed), failed is a mistake or the last hint, abandoned is a skip
  status       PuzzleAttemptStatus @default(open)
  mistakes     Int                 @default(0)
  // The highest hint level used, 0 when none
  hintLevel    Int                 @default(0) @map("hint_level")
  // The chain of hints (piece, idea, move) starts again at every move of the line: the level reached
  // at the move with this index
  moveHintLevel Int                @default(0) @map("move_hint_level")
  moveHintAt    Int                @default(-1) @map("move_hint_at")
  // The solver's moves accepted so far
  playedMoves  String[]            @default([]) @map("played_moves")
  // Set when the line is finished, also after mistakes
  solvedAt     DateTime?           @map("solved_at")
  // No more moves are taken after this: the puzzle is solved, given up or left for the next one
  closedAt     DateTime?           @map("closed_at")
  // Only the first run at a puzzle changes the rating, so that a known solution cannot be farmed
  rated        Boolean             @default(true)
  ratingBefore Int                 @map("rating_before")
  // Set once the attempt has changed the player's rating, which happens only once per attempt
  ratingAfter  Int?                @map("rating_after")
  startedAt    DateTime            @default(now()) @map("started_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, puzzleId])
  @@map("puzzle_attempts")
}

model UserPuzzleStats {
  userId     String   @id @map("user_id") @db.Uuid
  // A simplified Elo, kept as a float so that small changes do not vanish in rounding
  rating     Float    @default(1000)
  solved     Int      @default(0)
  failed     Int      @default(0)
  streak     Int      @default(0)
  bestStreak Int      @default(0) @map("best_streak")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_puzzle_stats")
}

// The puzzle of the day is picked on the first request and then kept, so that everybody gets the same one
model DailyPuzzle {
  day      DateTime @id @db.Date
  puzzleId String   @map("puzzle_id")

  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@map("daily_puzzles")
}
