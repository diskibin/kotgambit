# Copy to .env and fill in. Never commit real values.

# API
PORT=3000
DATABASE_URL=postgresql://kotgambit:kotgambit@localhost:5432/kotgambit
REDIS_URL=redis://localhost:6379
WEB_URL=http://localhost:5173
# Without SMTP_URL emails (with their links) are written to the API log
# SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=Кот Гамбит <noreply@example.com>

# Engine. Without ENGINE_PATH the analysis endpoint answers 503 and /ready reports no engine.
# The version used in CI is pinned in .github/workflows/ci.yml
# ENGINE_PATH=/usr/local/bin/stockfish
# One single-threaded process per worker, the default is the number of cores minus one
# ENGINE_WORKERS=2
# ENGINE_THREADS=1
# ENGINE_HASH_MB=64
# Requests that may wait in line, more are turned away with 503 and Retry-After
# ENGINE_QUEUE_LIMIT=20
# Time budget of one search in milliseconds, a search past it is stopped and returns its best so far
# ENGINE_TIMEOUT_MS=5000
# ENGINE_RETRY_AFTER_SECONDS=3
# ENGINE_CACHE_TTL_SECONDS=86400

# Premium. Billing is on only when the shop and both prices are set. Use the keys of the YooKassa
# test shop in development and staging, the real ones only on the server (PLAN.md 6.8)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Whole rubles
# BILLING_PRICE_MONTH_RUB=
# BILLING_PRICE_YEAR_RUB=
# A shop connected to "Чеки от ЮKassa" refuses a payment without a receipt: turn this on then.
# BILLING_RECEIPT=false
# VAT code of the receipt, 1 is no VAT
# BILLING_VAT_CODE=1
# Tax system of the receipt (1 to 6), needed when the shop has several
# BILLING_TAX_SYSTEM_CODE=
# How often renewals are looked for, in minutes, 0 turns the check off
# BILLING_RENEWAL_CHECK_MINUTES=60

# Premium lessons. The lessons directory of a checkout of the private content repository.
# The seed and `pnpm validate:content` read it next to the free lessons in content/lessons
# CONTENT_PRIVATE_DIR=/srv/kotgambit-content/lessons

# Sign-in with a provider. A provider is on when its keys are set. Register the app at the provider
# with the redirect address API_URL/auth/oauth/<google|yandex|vk>/callback. In production use https
# API_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# VK_CLIENT_ID=
# Only for a VK ID app registered as a confidential one
# VK_SERVICE_TOKEN=
