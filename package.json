{
  "name": "kotgambit",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "services:up": "docker compose -f infra/compose.dev.yml up -d --wait",
    "services:down": "docker compose -f infra/compose.dev.yml down",
    "setup": "pnpm i && pnpm services:up && pnpm --filter @kotgambit/api generate && pnpm --filter @kotgambit/api prisma:deploy && pnpm --filter @kotgambit/api seed",
    "start:local": "pnpm setup && turbo run dev --filter=@kotgambit/api --filter=@kotgambit/web",
    "validate:content": "turbo run build --filter=@kotgambit/content-schema && node tools/validate-content.mjs",
    "content-guard": "node tools/content-guard.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "yaml": "^2.9.1"
  }
}
